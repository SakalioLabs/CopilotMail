# Development-only overrides for deploy/compose.dev.yaml.
# Production credentials must be supplied through Docker Secrets or mounted files.
COPILOTMAIL_DEV_POSTGRES_PASSWORD=replace-for-shared-development
COPILOTMAIL_DEV_MINIO_USER=copilotmail
COPILOTMAIL_DEV_MINIO_PASSWORD=replace-for-shared-development
# Development services stay on loopback unless an operator deliberately
# supplies a separately reviewed shared-host or Pilot override.
COPILOTMAIL_DEV_BIND_HOST=127.0.0.1
COPILOTMAIL_V2_HTTP_PORT=8081
COPILOTMAIL_ADMIN_HTTP_PORT=8083
COPILOTMAIL_MAIL_APP_HTTP_PORT=8084
COPILOTMAIL_DEV_MINIO_CONSOLE_PORT=9001
COPILOTMAIL_DEV_MINIO_API_PORT=9000

# Optional Stalwart PoC overlay: deploy/compose.mail-poc.yaml.
# This bootstrap credential is development-only and is injected only by
# compose.mail-bootstrap.yaml. Remove its value and never load that overlay
# after the permanent administrator is verified.
COPILOTMAIL_DEV_STALWART_BOOTSTRAP_ADMIN=admin:replace-before-bootstrap
# One canonical JMAP origin is published by Stalwart and consumed by every
# CopilotMail adapter. Keep the smoke JMAP URL below on this exact origin.
COPILOTMAIL_STALWART_PUBLIC_URL=http://host.docker.internal:8082
COPILOTMAIL_DEV_STALWART_HTTP_PORT=8082
COPILOTMAIL_DEV_STALWART_SMTP_PORT=2525
COPILOTMAIL_DEV_STALWART_SUBMISSION_PORT=2587
COPILOTMAIL_DEV_STALWART_SUBMISSIONS_PORT=2465
COPILOTMAIL_DEV_STALWART_IMAP_PORT=2143
COPILOTMAIL_DEV_STALWART_IMAPS_PORT=2993
# Ordinary-account interoperability smoke. Passwords are intentionally omitted:
# set them only in the invoking shell and never commit or redirect them to a file.
COPILOTMAIL_STALWART_POC_DOMAIN=example.test
COPILOTMAIL_STALWART_POC_SENDER_LOCAL=poc-sender
COPILOTMAIL_STALWART_POC_RECIPIENT_LOCAL=poc-recipient
# COPILOTMAIL_STALWART_POC_SENDER_PASSWORD=
# COPILOTMAIL_STALWART_POC_RECIPIENT_PASSWORD=
COPILOTMAIL_STALWART_SMOKE_HOST=127.0.0.1
COPILOTMAIL_STALWART_SMOKE_RELAY_PORT=2525
COPILOTMAIL_STALWART_SMOKE_SUBMISSION_PORT=2587
COPILOTMAIL_STALWART_SMOKE_IMAP_PORT=2143
COPILOTMAIL_STALWART_SMOKE_JMAP_URL=http://host.docker.internal:8082/.well-known/jmap
COPILOTMAIL_STALWART_SMOKE_SENDER_ADDRESS=poc-sender@example.test
COPILOTMAIL_STALWART_SMOKE_RECIPIENT_ADDRESS=poc-recipient@example.test
# COPILOTMAIL_STALWART_SMOKE_SENDER_PASSWORD=
# COPILOTMAIL_STALWART_SMOKE_RECIPIENT_PASSWORD=
COPILOTMAIL_STALWART_SMOKE_ALLOW_INSECURE_HTTP=true
COPILOTMAIL_STALWART_SMOKE_ALLOW_INSECURE_TLS=true
COPILOTMAIL_STALWART_SMOKE_TIMEOUT_SECONDS=10
COPILOTMAIL_STALWART_SMOKE_POLL_SECONDS=30
# Base-stack defaults remain soft so the control plane can be developed without
# Stalwart. compose.mail-poc.yaml deliberately overrides all five values to
# literal true and does not permit .env to weaken the normal Mail profile.
COPILOTMAIL_REQUIRE_MAIL_ENGINE=false
COPILOTMAIL_REQUIRE_MAIL_CONTENT=false
COPILOTMAIL_REQUIRE_MAIL_COMPOSE=false
COPILOTMAIL_REQUIRE_MAIL_SUBMISSION=false
COPILOTMAIL_REQUIRE_MAIL_EVENT_INGRESS=false

# Cluster-wide Agent SSE limits. The metrics listener remains internal to the
# Compose backend network and contains no tenant or Principal labels.
COPILOTMAIL_AGENT_EVENT_STREAM_TENANT_LIMIT=100
COPILOTMAIL_AGENT_EVENT_STREAM_PRINCIPAL_LIMIT=5
COPILOTMAIL_AGENT_INGRESS_TENANT_REQUESTS_PER_MINUTE=6000
COPILOTMAIL_AGENT_INGRESS_PRINCIPAL_REQUESTS_PER_MINUTE=600

# Development WORM audit archive. Compose creates this bucket with Object Lock.
COPILOTMAIL_AUDIT_ARCHIVE_BUCKET=copilotmail-audit
COPILOTMAIL_AUDIT_ARCHIVE_REGION=us-east-1
COPILOTMAIL_AUDIT_ARCHIVE_RETENTION_MODE=governance
COPILOTMAIL_AUDIT_ARCHIVE_RETENTION_DAYS=30

# Optional dedicated audit-maintenance profile. Use one isolated worker per
# tenant and a dedicated active Service Principal with audit.export.
# COPILOTMAIL_AUDIT_MAINTENANCE_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
# COPILOTMAIL_AUDIT_MAINTENANCE_ACTOR_PRINCIPAL_ID=00000000-0000-0000-0000-000000000000
# COPILOTMAIL_AUDIT_MAINTENANCE_KEY_ID=audit-dev-1
# COPILOTMAIL_AUDIT_MAINTENANCE_OBJECT_PREFIX=audit
# COPILOTMAIL_AUDIT_MAINTENANCE_INTERVAL_SECONDS=86400
# COPILOTMAIL_AUDIT_MAINTENANCE_FAILURE_THRESHOLD=3
# COPILOTMAIL_AUDIT_MAINTENANCE_MAX_PENDING_AGE_SECONDS=172800
# COPILOTMAIL_AUDIT_MAINTENANCE_MAX_CYCLE_SECONDS=21600
# Compose mounts audit-private.pem/audit-public.pem from deploy/secrets and
# keeps resumable export packages in a dedicated persistent volume.

# Production uses an HTTPS S3 endpoint (or AWS S3 without an endpoint override),
# Compliance mode, and the normal AWS workload-identity/credential provider chain.
# COPILOTMAIL_AUDIT_ARCHIVE_ENDPOINT=https://s3.company.example
# COPILOTMAIL_AUDIT_ARCHIVE_FORCE_PATH_STYLE=false
# COPILOTMAIL_AUDIT_ARCHIVE_ALLOW_INSECURE_HTTP=false

# Optional OTLP/HTTP span export. Production requires an HTTPS Collector URL
# without embedded credentials, query parameters, or fragments.
# COPILOTMAIL_OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.company.example:4318
# COPILOTMAIL_OTEL_SERVICE_NAME=copilotmail-control
# COPILOTMAIL_OTEL_EXPORT_TIMEOUT_SECONDS=10
# COPILOTMAIL_OTEL_ALLOW_INSECURE_HTTP=false
# Authentication headers, when required, must come from deployment Secrets:
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20REDACTED

# Enterprise human identity for the optional server-side Human OIDC BFF
# overlay, deploy/compose.human-session.yaml (uncomment together).
# COPILOTMAIL_OIDC_ISSUER=https://login.company.example/tenant
# COPILOTMAIL_OIDC_AUDIENCE=copilotmail-control
# COPILOTMAIL_REQUIRE_HUMAN_AUTH=true
# HTTP issuers are rejected; only local development/tests may explicitly set:
# COPILOTMAIL_OIDC_ALLOW_INSECURE_HTTP=false

# The base Compose stack deliberately keeps browser sessions disabled. The
# Human Session overlay forces both Human authentication requirements to true.
COPILOTMAIL_REQUIRE_HUMAN_SESSION=false
# COPILOTMAIL_HUMAN_SESSION_TTL_SECONDS=3600
# PostgreSQL enforces this hard limit independently for the Admin and Mail
# login-start routes across every control-plane replica.
COPILOTMAIL_HUMAN_LOGIN_REQUESTS_PER_MINUTE=600
# COPILOTMAIL_HUMAN_SESSION_ALLOW_INSECURE_COOKIE=false
#
# Human administration relying party. The IdP application must enable
# Authorization Code + PKCE and allow this exact callback URL:
# https://admin.company.example/api/v2/auth/admin/callback
# COPILOTMAIL_ADMIN_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
# COPILOTMAIL_ADMIN_OIDC_CLIENT_ID=copilotmail-admin-spa
# COPILOTMAIL_ADMIN_OIDC_SCOPE=openid profile email
# COPILOTMAIL_ADMIN_PUBLIC_ORIGIN=https://admin.company.example
#
# Human mail relying party. Its exact callback is:
# https://mail.company.example/api/v2/auth/mail/callback
# Optional UI preference only. The authenticated server-side mailbox directory
# remains authoritative; an unavailable or unauthorized value is ignored.
# COPILOTMAIL_MAIL_APP_MAILBOX_ID=00000000-0000-0000-0000-000000000000
# COPILOTMAIL_MAIL_APP_OIDC_CLIENT_ID=copilotmail-mail-spa
# COPILOTMAIL_MAIL_APP_OIDC_SCOPE=openid profile email
# COPILOTMAIL_MAIL_APP_PUBLIC_ORIGIN=https://mail.company.example
#
# Loopback-only HTTP development should use distinct cookie hosts because
# cookies do not isolate by port: for example http://127.0.0.1:8083 for Admin
# and http://localhost:8084 for Mail. This mode must explicitly set
# COPILOTMAIL_OIDC_ALLOW_INSECURE_HTTP=true and
# COPILOTMAIL_HUMAN_SESSION_ALLOW_INSECURE_COOKIE=true. Neither escape hatch is
# accepted in production. The encryption-key path is supplied by the overlay;
# never put key bytes in this file. See deploy/secrets/README.md.

# Agent OAuth private_key_jwt authorization server (configure all together).
# Signing keys must be mounted read-only into the API container in a deployment override.
# COPILOTMAIL_AGENT_OAUTH_ISSUER=https://mail.company.example
# COPILOTMAIL_AGENT_OAUTH_AUDIENCE=https://mail.company.example/api/v2
# COPILOTMAIL_AGENT_OAUTH_TOKEN_ENDPOINT=https://mail.company.example/oauth2/token
# Preferred production mode: atomically replaced, hot-reloaded JSON key-set manifest.
# COPILOTMAIL_AGENT_OAUTH_SIGNING_KEY_SET_FILE=/run/secrets/agent-oauth-keyset.json
# COPILOTMAIL_AGENT_OAUTH_SIGNING_KEY_RELOAD_SECONDS=30
# Legacy/single-key mode (use these three only when KEY_SET_FILE is absent):
# COPILOTMAIL_AGENT_OAUTH_SIGNING_KEY_ID=agent-as-2026-01
# COPILOTMAIL_AGENT_OAUTH_PRIVATE_KEY_FILE=/run/secrets/agent-oauth-private.pem
# COPILOTMAIL_AGENT_OAUTH_PUBLIC_KEY_FILE=/run/secrets/agent-oauth-public.pem
# COPILOTMAIL_AGENT_OAUTH_ACCESS_TOKEN_TTL_SECONDS=300
# COPILOTMAIL_REQUIRE_AGENT_AUTH=true
# HTTP is local-test only and rejected in production:
# COPILOTMAIL_AGENT_OAUTH_ALLOW_INSECURE_HTTP=false

# Native HTTPS and optional Agent mTLS (configure all together).
# The server requests a client certificate but permits Human/OIDC clients
# without one. Presented certificates must chain to CLIENT_CA_FILE.
# COPILOTMAIL_NATIVE_TLS_CERT_FILE=/run/secrets/control-plane-tls-cert.pem
# COPILOTMAIL_NATIVE_TLS_KEY_FILE=/run/secrets/control-plane-tls-key.pem
# COPILOTMAIL_NATIVE_TLS_CLIENT_CA_FILE=/run/secrets/agent-client-ca.pem

# Stable namespace for opaque Account/Document/Submission references. Every
# management/content/compose/submission/ingress role must use this same ID and
# origin. Keep it unchanged across credential rotation; a rebuilt or migrated
# data-plane namespace requires a new governed ID. The current single-instance
# migration maps existing Stalwart evidence to this legacy-primary UUID.
# COPILOTMAIL_MAIL_DATA_PLANE_ID=018f305d-3d0f-7b2a-9d68-7f4a3f6e2101
# COPILOTMAIL_MAIL_DATA_PLANE_ORIGIN=https://mail.company.example
# Current Migration 0053 registers this legacy-primary UUID. A different ID
# requires a governed registry/upgrade flow before startup; do not improvise it.
# Production mail-engine adapter. Configure both values together; credentials
# are file-mounted and never accepted from an environment variable.
# COPILOTMAIL_MAIL_ENGINE_BASE_URL=https://mail.company.example
# COPILOTMAIL_MAIL_ENGINE_API_TOKEN_FILE=/run/secrets/stalwart-jmap.token
# COPILOTMAIL_MAIL_ENGINE_TIMEOUT_SECONDS=10
# COPILOTMAIL_MAIL_ENGINE_ALLOW_INSECURE_HTTP=false
# COPILOTMAIL_REQUIRE_MAIL_ENGINE=true

# Least-privilege Human inbox JMAP credential. Never reuse the management API key.
# The token file is atomically rotated by an external OAuth Token Broker.
# COPILOTMAIL_MAIL_CONTENT_BASE_URL=https://mail.company.example
# COPILOTMAIL_MAIL_CONTENT_TOKEN_FILE=/run/secrets/copilotmail/mail-content.token
# COPILOTMAIL_MAIL_CONTENT_TIMEOUT_SECONDS=10
# COPILOTMAIL_MAIL_CONTENT_ALLOW_INSECURE_HTTP=false
# COPILOTMAIL_REQUIRE_MAIL_CONTENT=true

# Separate Human draft JMAP credential. It may resolve the Drafts mailbox and
# create/destroy draft Email objects, but must not submit mail or administer
# Stalwart. Never reuse the content or management credential.
# COPILOTMAIL_MAIL_COMPOSE_BASE_URL=https://mail.company.example
# COPILOTMAIL_MAIL_COMPOSE_TOKEN_FILE=/run/secrets/copilotmail/mail-compose.token
# COPILOTMAIL_MAIL_COMPOSE_TIMEOUT_SECONDS=10
# COPILOTMAIL_MAIL_COMPOSE_ALLOW_INSECURE_HTTP=false
# COPILOTMAIL_REQUIRE_MAIL_COMPOSE=true

# Separate outbound JMAP submission credential. It may read Identity and
# EmailSubmission state and create EmailSubmission objects, but must not edit
# drafts, read mailbox bodies, or administer Stalwart.
# COPILOTMAIL_MAIL_SUBMISSION_BASE_URL=https://mail.company.example
# COPILOTMAIL_MAIL_SUBMISSION_TOKEN_FILE=/run/secrets/copilotmail/mail-submission.token
# COPILOTMAIL_MAIL_SUBMISSION_TIMEOUT_SECONDS=10
# COPILOTMAIL_MAIL_SUBMISSION_ALLOW_INSECURE_HTTP=false
# COPILOTMAIL_REQUIRE_MAIL_SUBMISSION=true

# Authenticated Stalwart telemetry ingress. Configure both independent files.
# Production defaults to requiring this boundary.
# COPILOTMAIL_MAIL_EVENT_INGRESS_BEARER_TOKEN_FILE=/run/secrets/copilotmail/stalwart-events.bearer
# COPILOTMAIL_MAIL_EVENT_INGRESS_SIGNATURE_KEY_FILE=/run/secrets/copilotmail/stalwart-events.hmac
# COPILOTMAIL_REQUIRE_MAIL_EVENT_INGRESS=true

# Signed Agent webhook delivery (Worker). The JSON manifest and every referenced
# secret file must be mounted read-only into the Worker container.
# COPILOTMAIL_WEBHOOK_SIGNING_KEY_SET_FILE=/run/secrets/webhook-keyset.json
# COPILOTMAIL_WEBHOOK_TIMEOUT_SECONDS=10
# COPILOTMAIL_WEBHOOK_MAX_ATTEMPTS=12
# COPILOTMAIL_REQUIRE_WEBHOOK_DELIVERY=true
# Local integration tests only; both settings are rejected in production:
# COPILOTMAIL_WEBHOOK_ALLOW_INSECURE_HTTP=false
# COPILOTMAIL_WEBHOOK_ALLOW_PRIVATE_NETWORK=false
