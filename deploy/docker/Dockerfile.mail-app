FROM node:22.23.1-bookworm-slim AS builder
WORKDIR /workspace/web
COPY web/package.json web/package-lock.json ./
COPY web/mail-app/package.json ./mail-app/package.json
COPY web/design-system/package.json ./design-system/package.json
COPY web/admin-app/package.json ./admin-app/package.json
RUN npm ci
COPY web/mail-app ./mail-app
COPY web/design-system ./design-system
COPY web/scripts/check-bundle-budget.mjs ./scripts/check-bundle-budget.mjs
RUN npm run build --workspace @copilotmail/mail-app \
    && npm run bundle:check:mail

FROM nginx:1.28.3-alpine3.23
COPY deploy/nginx/mail-app.conf /etc/nginx/conf.d/default.conf
COPY deploy/docker/mail-runtime-config.sh /docker-entrypoint.d/40-mail-runtime-config.sh
COPY --from=builder /workspace/web/mail-app/dist /usr/share/nginx/html
RUN test "$(id -u nginx):$(id -g nginx)" = "101:101" \
    && chmod 0555 /docker-entrypoint.d/40-mail-runtime-config.sh
USER nginx
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --retries=5 \
  CMD wget -qO- http://127.0.0.1:8080/mail-healthz >/dev/null || exit 1
