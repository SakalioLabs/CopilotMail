FROM node:22.23.1-bookworm-slim AS builder

WORKDIR /workspace/web
COPY web/package.json web/package-lock.json ./
COPY web/admin-app/package.json ./admin-app/package.json
COPY web/mail-app/package.json ./mail-app/package.json
COPY web/design-system/package.json ./design-system/package.json
RUN npm ci

COPY web/admin-app ./admin-app
COPY web/design-system ./design-system
COPY web/scripts/check-bundle-budget.mjs ./scripts/check-bundle-budget.mjs
RUN npm run build --workspace @copilotmail/admin-app \
    && npm run bundle:check:admin

FROM nginx:1.28.3-alpine3.23

COPY deploy/nginx/admin-app.conf /etc/nginx/conf.d/default.conf
COPY deploy/docker/admin-runtime-config.sh /docker-entrypoint.d/40-admin-runtime-config.sh
COPY --from=builder /workspace/web/admin-app/dist /usr/share/nginx/html
RUN test "$(id -u nginx):$(id -g nginx)" = "101:101" \
    && chmod 0555 /docker-entrypoint.d/40-admin-runtime-config.sh
USER nginx

EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --retries=5 \
  CMD wget -qO- http://127.0.0.1:8080/admin-healthz >/dev/null || exit 1
